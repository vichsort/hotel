# Banco de Dados (Neon PostgreSQL)
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Servidor & Ambiente
PORT=3000
NODE_ENV=development
JWT_SECRET=sua_chave_secreta_jwt_para_assinar_tokens

# CORS (Origens permitidas separadas por vírgula para cookies httpOnly)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Cloudinary (Upload de Imagens de Categorias de Quarto)
CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
CLOUDINARY_API_KEY=sua_api_key_aqui
CLOUDINARY_API_SECRET=seu_api_secret_aqui
